# Required for inference: https://console.groq.com/keys
GROQ_API_KEY=

# Optional bearer protection for POST /ask. Store the value in a deployment secret manager.
CRAG_API_TOKEN=

# Comma-separated trusted browser origins. Leave empty if no browser client is used.
CRAG_ALLOWED_ORIGINS=

# Optional overrides
# CRAG_MODEL=openai/gpt-oss-120b
# CRAG_TOP_K=3
# CRAG_WEB_RESULTS=4
# CRAG_KB_PATH=data/knowledge_base.json
# CRAG_CHROMA_DIR=/var/lib/corrective-rag/chroma
# CRAG_LOG_LEVEL=INFO

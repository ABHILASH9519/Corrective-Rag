# Required. Free key: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Optional overrides (defaults shown)
# CRAG_MODEL=openai/gpt-oss-120b
# CRAG_TOP_K=3
# CRAG_WEB_RESULTS=4
# CRAG_KB_PATH=                # empty = built-in Indian Railways sample notes
# CRAG_ADDR=:8000              # PORT is used instead when a host sets it
# CRAG_MAX_CONCURRENT=4        # simultaneous questions before the API returns 429
# CRAG_RATE_PER_MINUTE=10      # per-client questions/minute on /ask; 0 = off
# CRAG_TRUST_PROXY=false       # true behind a reverse proxy so limits use the real client IP
# CRAG_LOG_LEVEL=info          # debug | info | warn | error
# CRAG_HELPDESK_NAME=Indian Railways
# CRAG_REWRITE_HINT=If the question is about trains, include "Indian Railways" or "IRCTC".
